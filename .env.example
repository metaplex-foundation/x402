# Base58-encoded 64-byte Solana keypair with USDC for the target x402 network.
SVM_PRIVATE_KEY=

# Metaplex x402 API base URL. Defaults to https://api.metaplex.com/x402 in examples.
# METAPLEX_X402_BASE_URL=https://api.metaplex.com/x402

# URL prefix where /x402 is mounted. Use http://localhost:3000/api locally.
# METAPLEX_API_BASE_URL=https://api.metaplex.com

# Metaplex x402 RPC URL. Defaults to https://api.metaplex.com/x402/rpc in examples.
# METAPLEX_X402_RPC_URL=https://api.metaplex.com/x402/rpc

# Optional custom Solana RPC URL for x402 SVM payment construction.
# SVM_RPC_URL=https://api.mainnet-beta.solana.com

# Metaplex Core asset owned by SVM_PRIVATE_KEY. Required for all Core asset and
# delegate examples. Delegate examples require a registered Agent Identity.
# CORE_ASSET_ADDRESS=
